<?xml version="1.0" encoding="UTF-8"?>
<!-- Template only. `boss-sched install-agent` renders this with real paths
     into ~/Library/LaunchAgents/ai.rever.boss.scheduler.plist. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.rever.boss.scheduler</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/boss-sched</string>
    <string>daemon</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/YOU/.boss/scheduler/daemon.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/.boss/scheduler/daemon.log</string>
</dict>
</plist>
